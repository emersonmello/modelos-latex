\useinnertheme{circles}


% -------------------------------------------------%
% Alterando a distância padrão dos ambientes itemize / enumerate
% -------------------------------------------------%
% https://tex.stackexchange.com/a/129544
\def\beamer@extra@frameoptions{}
\def\beamer@extra@setframeoptions#1%
  {\appto\beamer@extra@frameoptions{\setkeys{beamerframe}{#1}}}
\def\defaultframeoptions{\@ifstar
  {\def\beamer@extra@frameoptions{}\beamer@extra@setframeoptions}
  {\beamer@extra@setframeoptions}}
\define@key{beamerframe}{environment}%
  {\def\beamer@frameenvironmentsubst{#1}\beamer@extra@frameoptions}

% A new frame option for wider items
\define@key{beamerframe}{wide}[10pt]{%
\def\beamer@cramped{\itemsep #1\topsep0.5pt\relax}}

% Definir o espaçamento padrão entre os itens nas listas
\defaultframeoptions{wide=\beamerthemeifsclean@itemsep}
% -------------------------------------------------%


% Empty footline.
\defbeamertemplate{footline}{none}{}
\setbeamertemplate{footline}[frame number]
% -------------------------------------------------%


% ------------------------- %
% Background do slide do título
% ------------------------- %
\setbeamertemplate{background}{%
  \begin{tikzpicture}%
    \ifnum\thepage=1\relax%
      \ifx\beamerthemeifsclean@titlebackground\@empty
      \useasboundingbox (0,0) rectangle(\the\paperwidth,\the\paperheight);
      \fill[color=titlebgcolor] (0,0) rectangle (\the\paperwidth,\the\paperheight);
      \fi
    \fi
  \end{tikzpicture}
}

% ------------------------- %
% Title page
% ------------------------- %
\defbeamertemplate*{title page}{ifsclean}
{% 
\begin{tikzpicture}[overlay, remember picture]

  % Background do slide de título
  \ifx\beamerthemeifsclean@titlebackground\@empty\else
      \node[opacity=\beamerthemeifsclean@titlebackgroundopacity] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{\beamerthemeifsclean@titlebackground}};
  \fi

  % Bloco superior esquerdo: assunto, titulo e subtitulo
  \node [anchor=north west, text width=.85\paperwidth, align=left] (cabecalho)
    at ([xshift=.075\paperwidth,yshift=-.12\paperheight]current page.north west)
    {%
      \ifx\beamerthemeifsclean@subject\@empty\else
        {\usebeamerfont{subject}\usebeamercolor[titlefgcolor]{title}\insertsubject\par}\vspace{.5em}%
      \fi
      {\usebeamerfont{title}\usebeamercolor[titlefgcolor]{title}\inserttitle\par}\vspace{.5em}%
      {\usebeamerfont{subtitle}\usebeamercolor[titlefgcolor]{title}\insertsubtitle\par}%
    };

  % Bloco inferior direito: autor e data
  \node [anchor=south east, text width=.55\paperwidth, align=right, inner sep=0pt] (metadados)
    at ([xshift=-.075\paperwidth,yshift=.12\paperheight]current page.south east)
    {%
      {\usebeamercolor[titlefgcolor]{author}\usebeamerfont{author}\insertauthor\par}\vspace{.8em}%
      {\usebeamercolor[titlefgcolor]{author}\usebeamerfont{institute}\insertinstitute\par}\vspace{.8em}%
      {\usebeamercolor[titlefgcolor]{date}\usebeamerfont{date}\insertdate\par}%
    };

    % Para incluir imagem como LOGO ou o logo gerado com TikZ
    \ifx\beamerthemeifsclean@logo\@empty
      \node [anchor=south west] (logoifsc) at ([xshift=.075\paperwidth,yshift=.08\paperheight]current page.south west) {\usebox\ifsclogotexto};
    \else
      \node [anchor=south west] (logoifsc) at ([xshift=.075\paperwidth,yshift=.08\paperheight]current page.south west) {\includegraphics[width=\beamerthemeifsclean@logowidth]{\beamerthemeifsclean@logo}};
    \fi

\end{tikzpicture}%
}
% ------------------------- %